---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Hubo un problema — Vendeto" description="No se pudo completar el pago. Intentá nuevamente.">
  <Header />
  <main>
    <section class="result-section">
      <div class="result-card error">
        <div class="icon">&#10007;</div>
        <h1>Hubo un problema</h1>
        <p>No se pudo completar el pago. Revisá tus datos e intentá nuevamente.</p>
        <div class="actions">
          <a href="/#precios" class="btn btn-primary">Volver a los planes</a>
          <a
            href="https://wa.me/5491138663629?text=Hola%2C%20tuve%20un%20problema%20al%20contratar%20un%20plan"
            target="_blank"
            rel="noopener"
            class="btn btn-ghost"
          >
            Escribinos por WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .result-section { padding: 96px 0; background: var(--ink-50); min-height: 60vh; }
  .result-card {
    background: var(--white);
    border-radius: var(--radius);
    padding: 48px 32px;
    text-align: center;
    max-width: 560px;
    margin: 0 auto;
    box-shadow: var(--shadow);
  }
  .icon { font-size: 2.5rem; margin-bottom: 16px; color: #dc2626; }
  .result-card h1 { font-size: 1.8rem; font-weight: 800; margin-bottom: 8px; }
  .result-card p { color: var(--ink-500); margin-bottom: 24px; }
  .actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
</style>