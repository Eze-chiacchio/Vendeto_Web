---
const CONTACT_URL = 'https://posweb-mailer.chiacchio-eze01.workers.dev/contact';
---

<section id="contacto" class="section">
  <div class="container contact-grid">
    <div class="contact-copy">
      <span class="eyebrow">Contacto</span>
      <h2 class="section-title">¿Tenés una consulta?</h2>
      <p class="section-sub">
        Dejanos tu nombre, tu email y tu consulta. Te respondemos a la brevedad.
      </p>
      <ul class="contact-links">
        <li><a href="mailto:soporte@vendeto.com.ar">soporte@vendeto.com.ar</a></li>
        <li><a href="https://wa.me/5491138663629?text=Hola%2C%20quiero%20info%20sobre%20Vendeto" target="_blank" rel="noopener">WhatsApp</a></li>
        <li><a href="tel:+5491138663629">+54 9 11 3866-3629</a></li>
      </ul>
    </div>

    <form class="contact-form" data-contact-form action="#contacto" method="post">
      <div class="field">
        <label for="contact-nombre">Nombre</label>
        <input id="contact-nombre" name="nombre" type="text" maxlength="100" required autocomplete="name" placeholder="Tu nombre" />
      </div>
      <div class="field">
        <label for="contact-email">Email</label>
        <input id="contact-email" name="email" type="email" required autocomplete="email" placeholder="tu@email.com" />
      </div>
      <div class="field">
        <label for="contact-consulta">Consulta</label>
        <textarea id="contact-consulta" name="consulta" rows="5" minlength="10" maxlength="2000" required placeholder="Contanos en qué podemos ayudarte"></textarea>
      </div>
      <button type="submit" class="btn btn-primary contact-submit" data-contact-submit>Enviar consulta</button>
      <p class="contact-status" data-contact-status role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script define:vars={{ CONTACT_URL }}>
  const form = document.querySelector('[data-contact-form]');
  const submit = form?.querySelector('[data-contact-submit]');
  const status = form?.querySelector('[data-contact-status]');

  function setStatus(message, kind = '') {
    if (!status) return;
    status.textContent = message;
    status.className = 'contact-status' + (kind ? ' contact-status-' + kind : '');
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submit) return;

    const nombre = form.nombre.value.trim();
    const email = form.email.value.trim();
    const consulta = form.consulta.value.trim();

    if (!nombre || !email || !consulta) {
      setStatus('Completá todos los campos.', 'error');
      return;
    }

    submit.disabled = true;
    submit.textContent = 'Enviando...';
    setStatus('');

    try {
      const res = await fetch(CONTACT_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nombre, email, consulta }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'No se pudo enviar la consulta');
      form.reset();
      setStatus('¡Consulta enviada! Te respondemos a la brevedad.', 'success');
    } catch (err) {
      setStatus(err.message || 'Ocurrió un error. Intentá de nuevo.', 'error');
    } finally {
      submit.disabled = false;
      submit.textContent = 'Enviar consulta';
    }
  });
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: start;
  }
  .contact-links {
    list-style: none;
    margin-top: 24px;
  }
  .contact-links li { margin-bottom: 12px; }
  .contact-links a {
    color: var(--blue-600);
    font-weight: 600;
  }
  .contact-links a:hover { text-decoration: underline; }
  .contact-form {
    background: var(--white);
    border: 1px solid var(--ink-100);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 32px;
  }
  .field { margin-bottom: 20px; }
  .field label {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-700);
    margin-bottom: 8px;
  }
  .field input,
  .field textarea {
    width: 100%;
    border: 1px solid var(--ink-100);
    border-radius: 12px;
    padding: 12px 14px;
    font-size: 1rem;
    font-family: inherit;
    color: var(--ink-900);
    background: var(--ink-50);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--blue-600);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    background: var(--white);
  }
  .field textarea { resize: vertical; }
  .contact-submit { width: 100%; }
  .contact-status { margin-top: 16px; font-size: 0.9rem; }
  .contact-status-success { color: #16a34a; }
  .contact-status-error { color: #dc2626; }
  @media (max-width: 860px) {
    .contact-grid { grid-template-columns: 1fr; gap: 40px; }
  }
</style>