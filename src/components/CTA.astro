<section id="contacto" class="section cta">
  <div class="container cta-box">
    <h2 class="cta-title">Listo para digitalizar tu comercio</h2>
    <p class="cta-sub">
      Contanos sobre tu negocio y te mostramos cómo Vendeto puede ayudarte.
      Podés empezar gratis hoy mismo.
    </p>
    <div class="cta-actions">
      <a href="/api/latest?download=1" class="btn btn-primary">Descargar Vendeto</a>
      <a
        href="https://wa.me/5491138663629?text=Hola%2C%20quiero%20info%20sobre%20Vendeto"
        target="_blank"
        rel="noopener"
        class="btn btn-cta-ghost"
      >
        Escribinos por WhatsApp
      </a>
      <a href="mailto:soporte@vendeto.com.ar" class="btn btn-cta-ghost">Contactar ventas</a>
    </div>
  </div>
</section>

<style>
  .cta-box {
    text-align: center;
    background: var(--grad);
    border-radius: 24px;
    padding: 72px 32px;
    color: var(--white);
    box-shadow: var(--shadow-lg);
  }
  .cta-title {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 800;
    margin-bottom: 16px;
  }
  .cta-sub {
    font-size: 1.1rem;
    max-width: 560px;
    margin: 0 auto 32px;
    opacity: 0.92;
  }
  .cta-actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  .cta-actions .btn-primary { background: var(--white); color: var(--blue-600); box-shadow: 0 10px 30px rgba(0,0,0,0.2); }
  .btn-cta-ghost {
    background: rgba(255,255,255,0.12);
    color: var(--white);
    border: 1px solid rgba(255,255,255,0.4);
    border-radius: 12px;
    font-weight: 600;
    padding: 14px 26px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .btn-cta-ghost:hover { background: rgba(255,255,255,0.2); }
</style>